rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function claimTenantId() {
      return request.auth.token.tenantId;
    }

    function claimRole() {
      return request.auth.token.role;
    }

    function isTenantMember(tenantId) {
      return isSignedIn() && claimTenantId() == tenantId;
    }

    function hasRole(tenantId, roles) {
      return isTenantMember(tenantId) && claimRole() in roles;
    }

    function isAdmin(tenantId) {
      return hasRole(tenantId, ['admin']);
    }

    function isAdminOrReception(tenantId) {
      return hasRole(tenantId, ['admin', 'reception']);
    }

    function auditLogPath(tenantId, logId) {
      return /databases/$(database)/documents/tenants/$(tenantId)/auditLogs/$(logId);
    }

    // Client create/update must be batched with a fresh auditLogs entry (id in `auditId`) naming this
    // document and the caller — replaces the old onAuditableWrite trigger, which the Spark plan can't run.
    function audited(tenantId, entity, docId) {
      let logId = request.resource.data.get('auditId', '');
      let log = auditLogPath(tenantId, logId);
      return logId is string && logId != '' &&
        (resource == null || resource.data.get('auditId', '') != logId) &&
        existsAfter(log) &&
        getAfter(log).data.entity == entity &&
        getAfter(log).data.entityId == docId &&
        getAfter(log).data.userId == request.auth.uid;
    }

    // Deletes can't carry a field, so their entry lives at a deterministic id: del-{entity}-{docId}.
    function auditedDelete(tenantId, entity, docId) {
      let log = auditLogPath(tenantId, 'del-' + entity + '-' + docId);
      return existsAfter(log) &&
        getAfter(log).data.action == 'delete' &&
        getAfter(log).data.userId == request.auth.uid;
    }

    match /tenants/{tenantId} {
      allow get: if isTenantMember(tenantId);
      allow update: if isAdmin(tenantId);
      // create/delete happen only via the createTenant Cloud Function (Admin SDK).
      allow create, delete: if false;

      match /staff/{staffId} {
        allow read: if isTenantMember(tenantId);
        // Profiles are created by the invite route; role/active/email mirror Auth claims and change only via the server.
        allow create: if false;
        allow update: if isAdmin(tenantId) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'active', 'email', 'emailNormalized']) &&
          audited(tenantId, 'staff', staffId);
        allow delete: if false; // deactivate via `active: false`, never delete.
      }

      match /customers/{customerId} {
        allow read: if isTenantMember(tenantId);
        allow create, update: if isAdminOrReception(tenantId) && audited(tenantId, 'customers', customerId);
        allow delete: if false; // soft delete only (`active: false`).
      }

      match /rooms/{roomId} {
        allow read: if isTenantMember(tenantId);
        allow create, update: if isAdmin(tenantId) && audited(tenantId, 'rooms', roomId);
        allow delete: if isAdmin(tenantId) && auditedDelete(tenantId, 'rooms', roomId);
      }

      match /services/{serviceId} {
        allow read: if isTenantMember(tenantId);
        allow create, update: if isAdmin(tenantId) && audited(tenantId, 'services', serviceId);
        allow delete: if isAdmin(tenantId) && auditedDelete(tenantId, 'services', serviceId);
      }

      match /products/{productId} {
        allow read: if isTenantMember(tenantId);
        // Reception may only move stock (the client-side stock movement transaction); price etc. stay admin-only.
        allow update: if audited(tenantId, 'products', productId) && (isAdmin(tenantId) ||
          (isAdminOrReception(tenantId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mevcutStok', 'auditId'])));
        allow create: if isAdmin(tenantId) && audited(tenantId, 'products', productId);
        allow delete: if isAdmin(tenantId) && auditedDelete(tenantId, 'products', productId);
      }

      match /stockMovements/{movementId} {
        allow read: if isTenantMember(tenantId);
        allow create: if isAdminOrReception(tenantId) &&
          request.resource.data.createdBy == request.auth.uid &&
          request.resource.data.qty is int && request.resource.data.qty != 0 &&
          exists(/databases/$(database)/documents/tenants/$(tenantId)/products/$(request.resource.data.productId));
        allow update, delete: if false; // immutable movement log.
      }

      match /packagePlans/{planId} {
        allow read: if isTenantMember(tenantId);
        allow create, update: if isAdmin(tenantId) && audited(tenantId, 'packagePlans', planId);
        allow delete: if isAdmin(tenantId) && auditedDelete(tenantId, 'packagePlans', planId);
      }

      match /customerPackages/{packageId} {
        allow read: if isTenantMember(tenantId);
        // Sales go through the sellPackage callable so the payment is recorded atomically.
        allow create: if false;
        allow update: if isAdminOrReception(tenantId) && audited(tenantId, 'customerPackages', packageId);
        allow delete: if false;
      }

      match /appointments/{appointmentId} {
        allow read: if isTenantMember(tenantId);
        // Create/reschedule go through the saveAppointment route (overlap + leave checks);
        // clients may only move an open appointment along the status flow. "Tamamlandı" is set by POS checkout only.
        allow create: if false;
        allow update: if isAdminOrReception(tenantId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'updatedBy', 'auditId']) &&
          resource.data.status in ['Bekliyor', 'Onaylandı', 'Geldi'] &&
          request.resource.data.status in ['Bekliyor', 'Onaylandı', 'Geldi', 'Gelmedi', 'İptal'] &&
          request.resource.data.updatedBy == request.auth.uid &&
          audited(tenantId, 'appointments', appointmentId);
        allow delete: if false; // cancel via status: 'İptal'.
      }

      // Sessions (POS) are written exclusively by the checkoutSession callable (Admin SDK bypasses rules).
      match /sessions/{sessionId} {
        allow read: if isTenantMember(tenantId);
        allow write: if false;
      }

      match /payments/{paymentId} {
        allow read: if isTenantMember(tenantId);
        // All payments (manual, refunds) go through the server so amounts and the closed cash-day lock are enforced.
        allow write: if false;
      }

      match /commissionRules/{ruleId} {
        allow read: if isAdmin(tenantId);
        allow create, update: if isAdmin(tenantId) && audited(tenantId, 'commissionRules', ruleId);
        allow delete: if isAdmin(tenantId) && auditedDelete(tenantId, 'commissionRules', ruleId);
      }

      // Accruals are written by checkoutSession/payoutCommissions callables only.
      match /commissionAccruals/{accrualId} {
        allow read: if isAdmin(tenantId) || (isTenantMember(tenantId) && resource.data.staffId == request.auth.uid);
        allow write: if false;
      }

      match /commissionPayouts/{payoutId} {
        allow read: if isAdmin(tenantId);
        allow write: if false;
      }

      match /expenses/{expenseId} {
        allow read: if isAdmin(tenantId);
        allow create, update: if isAdmin(tenantId) && audited(tenantId, 'expenses', expenseId);
        allow delete: if isAdmin(tenantId) && auditedDelete(tenantId, 'expenses', expenseId);
      }

      // Cash register days are only ever written by closeCashRegisterDay/reopenCashRegisterDay.
      match /cashRegisterDays/{dateId} {
        allow read: if isTenantMember(tenantId);
        allow write: if false;
      }

      match /staffLeaves/{leaveId} {
        allow read: if isTenantMember(tenantId);
        // Admin/reception record approved leave for anyone; other staff may only request their own
        // (status 'beklemede') and an admin approves or rejects it. Only approved leave blocks bookings.
        allow create: if request.resource.data.startDate <= request.resource.data.endDate &&
          ((isAdminOrReception(tenantId) && request.resource.data.status in ['onaylandi', 'beklemede']) ||
           (isTenantMember(tenantId) && request.resource.data.staffId == request.auth.uid &&
            request.resource.data.status == 'beklemede')) &&
          audited(tenantId, 'staffLeaves', leaveId);
        allow update: if isAdmin(tenantId) &&
          request.resource.data.get('status', 'onaylandi') in ['beklemede', 'onaylandi', 'reddedildi'] &&
          request.resource.data.startDate <= request.resource.data.endDate &&
          audited(tenantId, 'staffLeaves', leaveId);
        allow delete: if isAdmin(tenantId) && auditedDelete(tenantId, 'staffLeaves', leaveId);
      }

      match /tasks/{taskId} {
        allow read: if isTenantMember(tenantId);
        allow create: if isAdminOrReception(tenantId) && audited(tenantId, 'tasks', taskId);
        allow update: if (isAdminOrReception(tenantId) ||
          (isTenantMember(tenantId) && resource.data.staffId == request.auth.uid)) &&
          audited(tenantId, 'tasks', taskId);
        allow delete: if isAdmin(tenantId) && auditedDelete(tenantId, 'tasks', taskId);
      }

      // The server writes IP-attributed entries (Admin SDK). Clients may only append an entry for
      // themselves alongside an audited write; entries are immutable and can't claim an IP.
      match /auditLogs/{logId} {
        allow read: if isAdmin(tenantId);
        allow create: if isTenantMember(tenantId) &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.action in ['create', 'update', 'delete'] &&
          (request.resource.data.action == 'delete') == logId.matches('del-.*') &&
          request.resource.data.createdAt == request.time &&
          !('ip' in request.resource.data);
        allow update, delete: if false;
      }


      match /invites/{inviteId} {
        allow read: if isAdmin(tenantId);
        allow write: if false;
      }
    }
  }
}
