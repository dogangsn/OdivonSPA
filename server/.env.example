PORT=8787
GCLOUD_PROJECT=odivonspa

# Full contents of the Firebase service-account JSON key (Firebase Console > Project settings >
# Service accounts > Generate new private key). Not needed when FIRESTORE_EMULATOR_HOST /
# FIREBASE_AUTH_EMULATOR_HOST are set (local dev against the emulator suite).
FIREBASE_SERVICE_ACCOUNT_KEY=

# Comma-separated list of allowed CORS origins.
ALLOWED_ORIGINS=http://localhost:4200

# Shared secret required in the X-Cron-Secret header for POST /internal/mark-expired-packages.
CRON_SECRET=
